# Copy to .env. Never commit .env. Use unique credentials, not the training password.
PORT=4000
HOST=127.0.0.1
APP_MODE=training
APP_ORIGINS=http://127.0.0.1:4000,http://localhost:4000,http://127.0.0.1:5173,http://localhost:5173
SECURE_COOKIES=false
# Optional licensed tile provider; rebuild after changing VITE_ map settings.
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
# First startup only: creates an operator if no operator exists.
BOOTSTRAP_OPERATOR_EMAIL=
BOOTSTRAP_OPERATOR_NAME=HQ Operator
BOOTSTRAP_OPERATOR_PASSWORD=
# Optional persistent data path. Existing data/state.json is migrated without deleting records.
RAKSHA_GRID_DATA_FILE=
MONGODB_URI=
MONGODB_DB=raksha_grid
# Use a long random secret for tickets to survive server restarts (sessions still expire).
DELIVERY_TICKET_SECRET=
# A route is configured only if both URL and key are set. URLs point to browser-reachable adapters.
# Gateway keys are server-only; never put them in VITE_ variables or browser code.
LOCAL_GATEWAY_URL=
LOCAL_GATEWAY_KEY=
RF_GATEWAY_URL=
RF_GATEWAY_KEY=
SATELLITE_GATEWAY_URL=
SATELLITE_GATEWAY_KEY=
# For npm run gateway on a separate machine (LOCAL NETWORK ONLY):
GATEWAY_HQ_URL=http://127.0.0.1:4000
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=4400
GATEWAY_ALLOWED_ORIGINS=http://127.0.0.1:4000,http://127.0.0.1:5173
